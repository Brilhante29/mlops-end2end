{
  "schema_version": 1,
  "workload_version": "2.0.0",
  "lifecycle_runs": 3,
  "dataset": {
    "sample_count": 1200,
    "feature_count": 8,
    "random_seed": 42
  },
  "quality_gate": {
    "metric": "roc_auc",
    "minimum": 0.8
  },
  "inference": {
    "warmup_requests": 20,
    "measured_requests": 300,
    "concurrency": 8
  },
  "orchestration": {
    "dag_id": "mlops_end2end",
    "execution_mode": "dags-test",
    "logical_date": "2026-01-01T00:00:00+00:00"
  },
  "registry": {
    "implementation": "mlflow",
    "tracking_backend": "sqlite-direct",
    "model_alias": "champion"
  },
  "aggregation": {
    "primary": "median",
    "retain_failures": true,
    "retain_raw_runs": true
  }
}
